<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.loanstudio" ExtensionBundleVersion="2.0.0" ExtensionBundleName="LOAN Studio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.loanstudio.studio" Version="2.0.0" />
    <Extension Id="com.loanstudio.reframe360" Version="2.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.loanstudio.studio">
      <DispatchInfo>
        <Resources>
          <MainPath>./studio/index.html</MainPath>
          <ScriptPath>./host/studio.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LOAN Studio</Menu>
          <Geometry>
            <Size><Height>820</Height><Width>520</Width></Size>
            <MinSize><Height>420</Height><Width>360</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.loanstudio.reframe360">
      <DispatchInfo>
        <Resources>
          <MainPath>./reframe/index.html</MainPath>
          <ScriptPath>./host/reframe.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--ignore-gpu-blocklist</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>LOAN Studio — Reframe 360</Menu>
          <Geometry>
            <Size><Height>860</Height><Width>1280</Width></Size>
            <MinSize><Height>480</Height><Width>720</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
