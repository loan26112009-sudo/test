  <Extension Id="com.loanstudio.studio">
    <HostList><Host Name="PPRO" Port="8098"/></HostList>
  </Extension>
  <Extension Id="com.loanstudio.reframe360">
    <HostList><Host Name="PPRO" Port="8099"/></HostList>
  </Extension>
</ExtensionList>
